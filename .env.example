# =============================================================================
# CRANIAL — Universal AI Integration Platform
# Example Environment Configuration (Copy to .env for local Docker Compose)
# NEVER commit real secrets to version control.
# =============================================================================

# Spring Profile (dev | staging | prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_DB=cranial
POSTGRES_USER=cranial
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432

# Redis (optional distributed rate limiter for multi-replica deployments)
REDIS_HOST=cranial-redis
REDIS_PORT=6379
CRANIAL_RATELIMIT_PROVIDER=in-memory
CRANIAL_MAINTENANCE_CRON=0 0 * * * *

# Backend Server
BACKEND_PORT=8080

# Platform Security Secrets (MUST be replaced with high-entropy >=32-byte secrets in staging/prod)
CRANIAL_API_KEY_PEPPER=dev-only-api-key-pepper-replace-in-prod-32bytes-min
CRANIAL_ENCRYPTION_KEY=dev-only-aes256-master-key-replace-in-prod-32b
CRANIAL_ADMIN_JWT_SECRET=dev-only-admin-jwt-hmac-secret-replace-in-prod-32b
CRANIAL_ADMIN_JWT_TTL_MINUTES=30

# First-Run Bootstrap Operator (seeded only when platform_users table is empty)
CRANIAL_BOOTSTRAP_ADMIN_EMAIL=admin@cranial.local
CRANIAL_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!Cranial2026
CRANIAL_BOOTSTRAP_ADMIN_NAME=CRANIAL Operator

# Admin UI
ADMIN_UI_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

